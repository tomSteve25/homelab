# --- General ---
TZ=America/New_York

# --- Tailscale ---
# Generate at: https://login.tailscale.com/admin/settings/keys
# Use a reusable, ephemeral key tagged with tag:homelab
TS_AUTHKEY=tskey-auth-XXXX

# --- Pi-hole ---
PIHOLE_PASSWORD=changeme
PIHOLE_UPSTREAM_DNS=9.9.9.9;149.112.112.112

# --- Cloudflare ---
# Tunnel token from the Cloudflare Zero Trust dashboard
CF_TUNNEL_TOKEN=
